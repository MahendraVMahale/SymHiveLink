# SymHiveLink .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Distribution
dist/
build/
*.egg-info/
*.spec

# Config (user-specific, never commit)
config.json
registry.json
history.json
profiles/

# Logs
*.log
logs/

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Environment variables
.env
.env.local
